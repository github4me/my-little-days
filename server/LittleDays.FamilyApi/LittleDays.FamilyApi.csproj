<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Match the verified App Service baseline so newer SDKs keep the app-local Pkcs patch. -->
    <FrameworkReference Update="Microsoft.AspNetCore.App" TargetingPackVersion="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.84.2" />
    <!-- Override SqlClient's transitive version for CVE-2026-70162 / CVE-2026-84008. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Historical EF sources remain for adoption tests, not API execution. -->
    <Compile Remove="Migrations/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Schemas/sleep-prediction-remaining-day-v3.schema.json"
                      LogicalName="LittleDays.FamilyApi.SleepPredictionRemainingDayV3Schema" />
  </ItemGroup>
</Project>
