{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "None"
    }
  },
  "AllowedHosts": "*",
  "Admission": {
    "Mode": "Directory",
    "EmailOtpOnly": false,
    "UseAccountDeletionCredentials": false
  },
  "AccountDeletion": {
    "PollIntervalMinutes": 120,
    "WorkerEnabled": true
  }
}
