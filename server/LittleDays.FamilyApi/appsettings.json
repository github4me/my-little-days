{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "None"
    }
  },
  "AllowedHosts": "*",
  "SleepAi": {
    "Enabled": false,
    "ChildDataProcessingApproved": false,
    "ZeroDataRetentionApproved": false,
    "HardSpendControlVerified": false,
    "Model": "gpt-6-luna",
    "SupportsTemperature": false,
    "MaxRequestsPerAccountPerHour": 6,
    "MaxRequestsPerInstancePerDay": 200
  },
  "Admission": {
    "Mode": "Directory",
    "EmailOtpOnly": false,
    "UseAccountDeletionCredentials": false
  },
  "AccountDeletion": {
    "PollIntervalMinutes": 120,
    "WorkerEnabled": true
  },
  "Push": {
    "RegistrationEnabled": false,
    "EventCreationEnabled": false,
    "DeliveryEnabled": false,
    "AllowAllUsers": false,
    "Environment": "production",
    "MaxInstallationsPerAccount": 5
  }
}
