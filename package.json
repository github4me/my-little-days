{
  "name": "little-days",
  "description": "小日子：单机离线婴儿成长记录",
  "license": "0BSD",
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "version": "0.2.1",
  "main": "index.ts",
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.20",
    "expo-auth-session": "~57.0.12",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.18",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@types/react": "~19.2.2",
    "expo-mcp": "~0.2.1",
    "jimp-compact": "0.16.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "test:family-controller": "node --test tests/family-controller.mjs",
    "test:family-auth": "node --test tests/family-auth.mjs",
    "test:family-push": "node --test tests/family-push-native.mjs",
    "test:watch-native": "node --test plugins/tests/watch-companion.test.cjs plugins/tests/today-widget.test.cjs tests/widget-link.mjs",
    "test:widget": "node --test plugins/tests/today-widget.test.cjs tests/widget-link.mjs",
    "eas-build-post-install": "node plugins/tests/widget-model.cjs",
    "test:watch-prebuild": "node plugins/tests/prebuild-watch.cjs",
    "test:family-ui": "node --test tests/family-ui.mjs",
    "test:family-sync-status": "node --test tests/family-sync-status.mjs",
    "test:owner-setup": "node --test tests/owner-setup.mjs",
    "test:family-play": "node --test tests/family-play.mjs",
    "test:family-extras-capture": "node --test tests/family-extras-capture.mjs",
    "test:shared-reminders-ui": "node --test tests/shared-reminders-ui.mjs",
    "test:care-picker": "node --test tests/care-picker.mjs",
    "test:apple-ui": "node --test tests/accessibility-preferences.mjs tests/shared-controls.mjs tests/app-navigation.mjs tests/apple-forms.mjs tests/calendar-accessibility.mjs tests/data-screen-accessibility.mjs",
    "test:apple-browser": "node tests/apple-guidance-browser.mjs",
    "test:native-security": "node --test tests/native-security.mjs tests/native-localization.mjs tests/reminders-native.mjs tests/family-reminders-native.mjs",
    "test:family-demo-browser": "node tests/family-demo-browser.mjs",
    "verify": "npm run typecheck && npm test && npm run test:family-auth && npm run test:family-push && npm run test:watch-native && npm run test:family-controller && npm run test:family-ui && npm run test:family-sync-status && npm run test:owner-setup && npm run test:family-play && npm run test:family-extras-capture && npm run test:shared-reminders-ui && npm run test:care-picker && npm run test:apple-ui && npm run test:native-security",
    "export:ios": "expo export --platform ios",
    "export:web": "expo export --platform web --output-dir dist-web",
    "test:browser": "node tests/browser.mjs",
    "test:night-appearance": "node tests/night-appearance-browser.mjs",
    "format": "prettier --write App.tsx src tests"
  },
  "engines": {
    "node": "^22.13.0 || >=24.3.0"
  }
}
