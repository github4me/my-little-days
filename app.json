{
  "expo": {
    "name": "My Little Days",
    "locales": {
      "en": {
        "ios": {
          "CFBundleDisplayName": "My Little Days"
        }
      },
      "zh-Hans": {
        "ios": {
          "CFBundleDisplayName": "小日子"
        }
      },
      "zh-Hant": {
        "ios": {
          "CFBundleDisplayName": "小日子"
        }
      }
    },
    "slug": "little-days",
    "version": "0.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F9FD"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.littledays.babylog",
      "buildNumber": "12",
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.littledays.babylog",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F9FD"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-notifications",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许小日子访问照片，以选择宝宝头像。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-localization"
    ],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "a5210f78-8729-46d4-82a4-7d1d40d30ac6"
      }
    },
    "owner": "expo4chao",
    "updates": {
      "url": "https://u.expo.dev/a5210f78-8729-46d4-82a4-7d1d40d30ac6"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
