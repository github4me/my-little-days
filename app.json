    "slug": "little-days",
    "version": "0.2.1",
    "scheme": "mylittledays",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F9FD"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.littledays.babylog",
      "buildNumber": "38",
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.littledays.babylog",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F9FD"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-notifications",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow My Little Days to access the photos you choose for your baby's avatar.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "zh-Hans",
            "zh-Hant",
            "fr",
            "de",
            "hi",
            "it",
            "ja",
            "ko",
            "es",
            "th",
            "vi"
          ]
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "./plugins/with-watch-companion",
      "./plugins/with-today-widget"
    ],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "a5210f78-8729-46d4-82a4-7d1d40d30ac6"
      }
    },
    "owner": "expo4chao",
    "updates": {
      "enabled": false,
      "url": "https://u.expo.dev/a5210f78-8729-46d4-82a4-7d1d40d30ac6"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
